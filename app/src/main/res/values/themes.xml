<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DailyCheck" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- 登录页主题：无 ActionBar，全屏居中 -->
    <style name="Theme.DailyCheck.Login" parent="Theme.DailyCheck">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>
